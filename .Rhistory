library(tidyverse)
dados_media <- tibble(
valor = c(2, 4, 4, 6, 9)
)
media_valor <- mean(dados_media$valor)
ggplot(
dados_media,
aes(x = valor)
) +
geom_dotplot(
binwidth = 1,
stackdir = "up",
dotsize = 0.9,
fill = "steelblue",
color = "black"
) +
geom_vline(
xintercept = media_valor,
linetype = "dashed",
linewidth = 1
) +
annotate(
"text",
x = media_valor,
y = 1.9,
label = paste0("Média = ", media_valor),
vjust = -0.5
) +
scale_x_continuous(
breaks = 0:10,
limits = c(0, 10)
) +
labs(
title = "A média como ponto de equilíbrio das observações",
x = "Valores observados",
y = NULL
) +
theme_minimal()
2+8+6+9
25/5
#| label: fig-media-equilibrio-10-pontos
#| fig-cap: "Gráfico de pontos com 10 observações e linha tracejada na média."
#| fig-alt: "Gráfico de pontos com 10 observações empilhadas e uma linha vertical tracejada na média igual a 5."
#| echo: false
library(tidyverse)
dados_media <- tibble(
valor = c(1, 2, 4, 4, 4, 6, 6, 7, 8, 8)
) |>
group_by(valor) |>
mutate(y = row_number()) |>
ungroup()
media_valor <- mean(dados_media$valor)
ggplot(dados_media, aes(x = valor, y = y)) +
geom_segment(
aes(xend = media_valor, yend = y),
linewidth = 0.8,
alpha = 0.7
) +
geom_point(size = 4) +
geom_vline(
xintercept = media_valor,
linetype = "dashed",
linewidth = 1
) +
annotate(
"text",
x = media_valor,
y = max(dados_media$y) + 0.6,
label = paste0("Média = ", media_valor),
vjust = 0
) +
scale_x_continuous(
breaks = 0:10,
limits = c(0, 10)
) +
labs(
title = "A média como ponto de equilíbrio das observações",
x = "Valores observados",
y = NULL
) +
theme_minimal()
#| label: fig-media-equilibrio-10-pontos
#| fig-cap: "Gráfico de pontos com 10 observações e linha tracejada na média."
#| fig-alt: "Gráfico de pontos com 10 observações empilhadas e uma linha vertical tracejada na média igual a 5."
#| echo: false
library(tidyverse)
dados_media <- tibble(
valor = c(1, 2, 4, 4, 4, 6, 6, 7, 8, 8)
) |>
group_by(valor) |>
mutate(y = row_number()) |>
ungroup()
media_valor <- mean(dados_media$valor)
ggplot(dados_media, aes(x = valor, y = y)) +
geom_segment(
aes(xend = media_valor, yend = y),
linewidth = 0.8,
alpha = 0.7
) +
geom_point(size = 4) +
geom_vline(
xintercept = media_valor,
linetype = "dashed",
linewidth = 1
) +
annotate(
"text",
x = media_valor,
y = max(dados_media$y) + 0.6,
label = paste0("Média = ", media_valor),
vjust = 0
) +
scale_x_continuous(
breaks = 0:10,
limits = c(0, 10)
) +
labs(
title = "A média como ponto de equilíbrio das observações",
x = "Valores observados",
y = NULL
) +
theme_minimal() +
theme(
axis.text.y = element_blank(),
axis.ticks.y = element_blank(),
panel.grid.major.y = element_blank(),
panel.grid.minor.y = element_blank()
)
#| label: fig-media-equilibrio-continua
#| fig-cap: "Média aritmética como ponto de equilíbrio para uma variável quantitativa contínua."
#| fig-alt: "Dez observações contínuas distribuídas ao longo de uma reta numérica, com uma linha vertical tracejada indicando a média igual a 5."
#| echo: false
library(tidyverse)
dados_media <- tibble(
valor = c(
1.2, 2.7, 3.4, 4.1, 4.8,
5.6, 6.3, 6.9, 7.2, 7.8
)
)
media_valor <- mean(dados_media$valor)
ggplot(
dados_media,
aes(x = valor, y = 0)
) +
geom_point(size = 4) +
geom_vline(
xintercept = media_valor,
linetype = "dashed",
linewidth = 1
) +
annotate(
"text",
x = media_valor,
y = 0.12,
label = paste0(
"Média = ",
media_valor
)
) +
scale_x_continuous(
breaks = seq(1, 8, by = 0.5),
limits = c(1, 8)
) +
labs(
x = "Valores observados",
y = NULL
) +
theme_minimal() +
theme(
axis.text.y = element_blank(),
axis.ticks.y = element_blank(),
panel.grid.major.y = element_blank(),
panel.grid.minor.y = element_blank()
)
#| label: fig-media-equilibrio-continua-distancias
#| fig-cap: "Distâncias das observações em relação à média de uma variável quantitativa contínua."
#| fig-alt: "Dez valores contínuos ligados por segmentos horizontais à média igual a 5, evidenciando a compensação das distâncias à esquerda e à direita."
#| echo: false
dados_media <- tibble(
valor = c(
1.2, 2.7, 3.4, 4.1, 4.8,
5.6, 6.3, 6.9, 7.2, 7.8
),
y = 1:10
)
media_valor <- mean(dados_media$valor)
ggplot(
dados_media,
aes(x = valor, y = y)
) +
geom_segment(
aes(
xend = media_valor,
yend = y
),
linewidth = 0.8
) +
geom_point(size = 4) +
geom_vline(
xintercept = media_valor,
linetype = "dashed",
linewidth = 1
) +
annotate(
"text",
x = media_valor,
y = 10.7,
label = paste0(
"Média = ",
media_valor
)
) +
scale_x_continuous(
breaks = seq(1, 8, by = 0.5),
limits = c(1, 8)
) +
labs(
x = "Valores observados",
y = NULL
) +
theme_minimal() +
theme(
axis.text.y = element_blank(),
axis.ticks.y = element_blank(),
panel.grid.major.y = element_blank(),
panel.grid.minor.y = element_blank()
)
